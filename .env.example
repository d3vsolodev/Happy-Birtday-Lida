# Copy these into Vercel: Project -> Settings -> Environment Variables
# (for local testing with `npx vercel dev`, copy this file to .env.local)

# 1) Where wishes are stored: a PRIVATE repo, as "owner/name"
GITHUB_REPO=TH3AN/lida-wishes
# Fine-grained personal access token limited to that one repo, permission: Issues = Read and write
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxx

# 2) Optional instant alert on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: extra allowed website origins (comma separated), e.g. a custom domain
ALLOWED_ORIGIN=
